# ATP-5 and ATP-6 read the hosted project from here. Copy this file to .env and fill it in; .env is
# git-ignored and never printed. All four come from the Supabase and Azure dashboards.

# The hosted backend's base URL, e.g. https://ca-sage-api.<id>.southafricanorth.azurecontainerapps.io
HOSTED_API_URL=
# The hosted Supabase project URL, e.g. https://<ref>.supabase.co
HOSTED_SUPABASE_URL=
# The hosted project's secret (service_role) key: makes and deletes the test accounts, and reads
# every public-schema row for the identifier scan. Skips row level security, so never shared.
HOSTED_SUPABASE_SECRET_KEY=
# The hosted project's publishable (anon) key: signs the test accounts in, and is the key A's
# direct REST attempts carry. Safe in a browser, so not a secret, but kept here beside the rest.
HOSTED_SUPABASE_PUBLISHABLE_KEY=
