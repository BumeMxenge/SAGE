# Backend settings: copy to .env and fill in. Never commit .env
SUPABASE_URL=
# Server-side secret key. Stays in the backend, never in the frontend
SUPABASE_SECRET_KEY=
# Websites allowed to call the API from a browser, comma-separated. Deploys set the hosted frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# OpenAI's key, which pays for SAGE's model: the advisor, and the drafts `sage ingest --draft`
# asks for. The backend won't start without it
OPENAI_API_KEY=
