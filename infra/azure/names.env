# Azure resource names, written once. infra/azure/setup.sh sources this file and both deploy
# workflows load it, so a name only ever changes here. Keep comments on their own lines.
# Names follow Microsoft's naming guide: a type prefix, then the project.

# The folder that holds everything below
RESOURCE_GROUP=rg-sage
# Where the backend's logs go
LOG_WORKSPACE=log-sage
# Container Apps environment: the space the backend runs in
CONTAINER_ENV=cae-sage
# The robot account GitHub Actions deploys as
DEPLOY_IDENTITY=id-sage-github
# The backend's container app. The first deploy creates it, since it needs an image.
API_APP=ca-sage-api
# Holds the frontend's files and serves them as a website. Its name starts the website's address
# (https://<name>.<zone>.web.core.windows.net), so it skips the type prefix to read cleanly.
# Storage names are unique across all of Azure and can't be renamed (docs/setup.md, troubleshooting).
STORAGE_ACCOUNT=sageuct
