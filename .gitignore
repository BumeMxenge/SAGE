# Files git never tracks: secrets, local environments, build output, caches and macOS clutter.
# This is the repo's only .gitignore, so every rule lives here.
.env
.env.*
!.env.example
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
node_modules/
dist/
private_data/
.DS_Store
# Test reports: coverage's data, and make mutation's working copy, its links to data/ and
# experiments/, and its score
.coverage
backend/mutants/
backend/data
backend/experiments
backend/mutation-score.txt
# Playwright's output: its results, the saved sign-in (it holds a session token) and the parity
# images
frontend/test-results/
frontend/e2e/.auth/
frontend/parity/
# The Supabase CLI's local state: which project this laptop is linked to
supabase/.temp/
supabase/.branches/
# My local setup: Claude Code's files and my laptop setup guide
.claude/
CLAUDE.md
CLAUDE.local.md
docs/setup.md
# Files made for local testing, such as make transcript's PDF
local/
