# Files git never tracks: secrets, local environments, build output, caches and macOS clutter.
# This is the repo's only .gitignore, so every rule lives here.
.env
.env.*
!.env.example
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
node_modules/
dist/
private_data/
.DS_Store
# The Supabase CLI's local state: which project this laptop is linked to
supabase/.temp/
supabase/.branches/
# Claude Code's per-laptop files: approvals you've saved and your own notes
.claude/settings.local.json
CLAUDE.local.md
