# Local Supabase's Microsoft sign-in, which the Supabase CLI reads when it starts. Copy this file to
# supabase/.env, which git ignores, and fill it in. Then restart: npx supabase@2.120.0 stop, then start
# Microsoft Entra admin centre > App registrations > SAGE > Overview > Application (client) ID
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=
# The Value of the "SAGE local" client secret (Certificates & secrets), shown only when it's made
SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=
# UCT's tenant URL, exactly as the hosted project's Azure provider has it in the Supabase dashboard
SUPABASE_AUTH_EXTERNAL_AZURE_URL=
