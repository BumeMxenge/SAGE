# Frontend settings: copy to .env and fill in. Vite only exposes names starting with VITE_
VITE_API_URL=http://localhost:8000
# Local Supabase. The deploy takes the hosted project's values from GitHub variables
VITE_SUPABASE_URL=http://127.0.0.1:54321
# PUBLISHABLE_KEY from npx supabase@2.120.0 status -o env. The publishable key only, never the secret
VITE_SUPABASE_PUBLISHABLE_KEY=
